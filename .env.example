# Copy to .env and fill in. The .env file is .gitignored.
#
# GitHub PAT with `repo` scope (covers traffic data on public + owned
# private repos -- private repos are filtered out at the API layer
# anyway, but the scope is the minimum that works).
#
# On the Mac you can leave this empty and the container falls back to
# `gh auth token` (gh is installed in the image).
GITHUB_TOKEN=

# Remote deploy only. Used by docker-compose.remote.yml for Traefik
# routing. Ignored by the dev compose file.
#
# DEPLOY_HOSTNAME: the public hostname Traefik should route to this
# service (e.g. traffic.example.com).
# TRAEFIK_NETWORK: the external Docker network Traefik watches
# (must already exist on the host; common names: `proxy`, `traefik`,
# `web`).
DEPLOY_HOSTNAME=
TRAEFIK_NETWORK=proxy

# Web UI session signing key. Used by Starlette's SessionMiddleware to
# sign the session cookie that holds the CSRF token. If unset, the app
# generates a random one at startup -- safe but invalidates sessions on
# every restart. For prod, set this to a stable random value:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
GITHUB_TRAFFIC_VAULT_SECRET_KEY=
